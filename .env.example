# Neon: 앱/worker는 pooled URL, Prisma migration은 direct URL을 사용합니다.
NETLIFY_DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"

# 관리자 대시보드 Basic Auth (production에서 누락되면 모든 관리자 경로가 fail-closed)
ADMIN_BASIC_AUTH_USERNAME="REPLACE_WITH_ADMIN_USERNAME"
ADMIN_BASIC_AUTH_PASSWORD="REPLACE_WITH_LONG_RANDOM_PASSWORD"

# 계정 토큰 AES-256-GCM 키. 웹과 VPS에 반드시 동일한 값을 한 번만 생성해 설정합니다.
# 생성: openssl rand -base64 32
THREADS_TOKEN_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# Meta Threads OAuth 앱. 계정 연결 직전에 입력해도 됩니다.
THREADS_APP_ID="REPLACE_WITH_THREADS_APP_ID"
THREADS_APP_SECRET="REPLACE_WITH_THREADS_APP_SECRET"
THREADS_OAUTH_REDIRECT_URI="https://YOUR_ADMIN_DOMAIN/api/oauth/callback"
THREADS_OAUTH_SCOPES="threads_basic,threads_content_publish,threads_manage_replies,threads_read_replies"
# 장애 복구용 수동 토큰 API는 기본 비활성입니다. 특별한 경우에만 true로 바꾸며 서버가 /me로 소유자를 검증합니다.
ALLOW_MANUAL_THREADS_TOKEN="false"

# Supabase Storage. service role key는 서버 환경에만 두고 브라우저에 노출하지 않습니다.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVICE_ROLE_KEY"
# 생성: openssl rand -hex 32
UPLOAD_SIGNING_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# 서버 간 관리 API. 각각 다른 임의 값으로 설정합니다.
CRON_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
INTERNAL_API_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# 같은 콘텐츠의 최근 재발행 차단 기간. 계절 콘텐츠는 기간이 지난 뒤 다시 검토·승인할 수 있습니다.
CONTENT_REUSE_COOLDOWN_DAYS="90"

# 선택: 템플릿 화면의 AI 초안 생성. 모델은 비용·품질 정책에 맞춰 명시적으로 고정합니다.
OPENAI_API_KEY="REPLACE_WITH_OPENAI_API_KEY"
OPENAI_MODEL="gpt-5.6"
