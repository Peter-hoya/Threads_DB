# Prisma datasource. Use the pooled Neon runtime URL and require TLS.
NETLIFY_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct (non-pooled) Neon URL used only by Prisma migration commands in the
# installer. The running worker continues to use NETLIFY_DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Canonical 32-byte AES-256 key, base64 encoded. This MUST be the same key
# configured on the admin application. Generate once with: openssl rand -base64 32
THREADS_TOKEN_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# Public project origin used to ensure approved media stays on the verified
# threads-publish bucket. No Supabase service-role key is needed on the VPS.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# Backward-compatible worker-only key name. Leave unset when the canonical key
# above is configured.
# TOKEN_ENCRYPTION_KEY_V1="REPLACE_WITH_BASE64_32_BYTE_KEY"

# Optional stable name. When omitted, hostname:pid is used.
WORKER_ID="threads-worker-vps-1"

# Queue and lease timing (milliseconds).
POLL_INTERVAL_MS=5000
LEASE_TIMEOUT_MS=120000
LEASE_HEARTBEAT_MS=40000
PROCESS_HEARTBEAT_MS=30000
API_TIMEOUT_MS=30000
RETRY_BASE_MS=30000
RETRY_MAX_MS=21600000

# Identical content remains blocked while queued/publishing and for this many
# days after a successful publication (1-3650, shared with the admin app).
CONTENT_REUSE_COOLDOWN_DAYS=90

# 1 performs a read-only preview and never leases or publishes a job.
DRY_RUN=0
DRY_RUN_ONCE=1

# Optional Telegram terminal-failure alerts.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
ALERT_ON_RETRY=0
